# YCKI 环境配置模板 — 复制为 config/.env 并填入真实值（config/.env 已 gitignore）
YCKI_PG_DSN=host=127.0.0.1 port=5433 dbname=ycki user=postgres password=CHANGE_ME
LIGHTRAG_API_KEY=CHANGE_ME
YCKI_LR_URL=http://localhost:9621
YCKI_GATEWAY_URL=http://your-llm-gateway/v1
YCKI_GATEWAY_KEY=CHANGE_ME
YCKI_LLM_MODEL=Qwen3.6-35B-A3B
YCKI_EMBED_MODEL=bge-m3
